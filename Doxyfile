# Doxyfile for SleakCraft Voxel Sandbox

PROJECT_NAME           = "SleakCraft Voxel Sandbox"
PROJECT_NUMBER         = "1.0.0"
PROJECT_BRIEF          = "Modern Voxel Sandbox Game Powered by SleakEngine"
OUTPUT_DIRECTORY       = docs

CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = YES
OUTPUT_LANGUAGE        = English

# Input source files and directories
INPUT                  = docs/mainpage.md \
 docs/pages \
 docs/groups.dox \
 Game/include \
 Game/src \
 Client
USE_MDFILE_AS_MAINPAGE = docs/mainpage.md
RECURSIVE              = YES
FILE_PATTERNS          = *.hpp \
 *.h \
 *.cpp \
 *.md \
 *.dox
EXTENSION_MAPPING      = hpp=C++ \
 h=C++ \
 cpp=C++
# Extraction settings
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_PRIV_VIRTUAL   = NO
EXTRACT_PACKAGE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_LOCAL_METHODS  = YES
EXTRACT_ANON_NSPACES   = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_FRIEND_COMPOUNDS  = NO
HIDE_IN_BODY_DOCS      = NO
INTERNAL_DOCS          = NO
CASE_SENSE_NAMES       = YES
SHORT_NAMES            = NO
SHOW_INCLUDE_FILES     = YES
SHOW_GROUPED_MEMB_INC  = YES
FORCE_INCLUDES         = NO
INLINE_INFO            = YES
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = YES
SORT_MEMBERS_CTORS_1ST = YES

# Markdown & formatting
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES
CPP_CLI_SUPPORT        = NO
SIP_SUPPORT            = NO

# Preprocessing
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
SEARCH_INCLUDES        = YES
INCLUDE_PATH           = Engine/include/public \
                         Game/include

# Warnings and logging
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO

# Output Formats
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_COLORSTYLE        = LIGHT
HTML_COLORSTYLE_HUE    = 140
HTML_COLORSTYLE_SAT    = 100
HTML_COLORSTYLE_GAMMA  = 80
HTML_DYNAMIC_MENUS     = YES
HTML_DYNAMIC_SECTIONS  = YES
HTML_INDEX_NUM_ENTRIES = 100
GENERATE_DOCSET        = NO
GENERATE_HTMLHELP      = NO
GENERATE_CHI           = NO
GENERATE_QHP            = NO
GENERATE_ECLIPSEHELP   = NO
GENERATE_TREEVIEW      = YES
TREEVIEW_WIDTH         = 335
ENUM_VALUES_PER_LINE   = 4

GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO
GENERATE_DOCBOOK       = NO

# Diagrams and Graphs (Graphviz/dot)
HAVE_DOT               = YES
DOT_NUM_THREADS        = 4
DOT_FONTNAME           = Helvetica
DOT_FONTSIZE           = 10
DOT_FONTPATH           =
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = NO
GROUP_GRAPHS           = YES
UML_LOOK               = YES
UML_LIMIT_NUM_FIELDS   = 10
DOT_UML_DETAILS        = YES
DOT_WRAP_THRESHOLD     = 17
TEMPLATE_RELATIONS     = YES
INCLUDE_GRAPH          = NO
INCLUDED_BY_GRAPH      = NO
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
GRAPHICAL_HIERARCHY    = YES
DIRECTORY_GRAPH        = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
DOT_GRAPH_MAX_NODES    = 100
MAX_DOT_GRAPH_DEPTH    = 0

WARN_IF_INCOMPLETE_DOC = YES

WARN_LOGFILE           = docs/doxygen_warnings.log

DISABLE_INDEX          = NO

FULL_SIDEBAR           = NO

HTML_EXTRA_STYLESHEET  = docs/theme/doxygen-awesome.css \
 docs/theme/custom.css
HTML_EXTRA_FILES       = docs/theme/doxygen-awesome-darkmode-toggle.js \
 docs/theme/doxygen-awesome-fragment-copy-button.js \
 docs/theme/doxygen-awesome-interactive-toc.js \
 docs/theme/doxygen-awesome-paragraph-link.js
SOURCE_BROWSER         = YES

STRIP_CODE_COMMENTS    = NO

TAGFILES               = ../SleakEngine/docs/SleakEngine.tag=../../../SleakEngine/docs/html

SHOW_USED_FILES        = NO

TIMESTAMP              = YES

HTML_HEADER            = docs/theme/header.html

EXTERNAL_PAGES         = NO

EXTERNAL_GROUPS        = NO

PROJECT_LOGO           = docs/theme/logo.svg

IMAGE_PATH             = docs/images

TOC_INCLUDE_HEADINGS   = 2

LAYOUT_FILE            = docs/theme/DoxygenLayout.xml
