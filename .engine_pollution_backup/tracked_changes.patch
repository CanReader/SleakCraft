+    VkDescriptorImageInfo envImgInfo{};
+    envImgInfo.imageLayout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+    envImgInfo.imageView   = envCubemapView;
+    envImgInfo.sampler     = envSampler;
