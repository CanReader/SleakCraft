+
+    // ======================== PREFILTER ========================
+    {
+        VkShaderModule pfVert = loadModule("assets/shaders/ibl_prefilter.vert.spv");
+        VkShaderModule pfFrag = loadModule("assets/shaders/ibl_prefilter.frag.spv");
+        VkRenderPass   pfRP   = makeRenderPass(HDR_FMT);
