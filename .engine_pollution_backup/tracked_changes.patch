+        vinfo.sType    = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO;
+        vinfo.image    = image;
+        vinfo.viewType = VK_IMAGE_VIEW_TYPE_2D;
+        vinfo.format   = m_ssaoFormat;
+        vinfo.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
