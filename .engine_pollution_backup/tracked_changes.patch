+                VkClearValue cv{};
+                VkRenderPassBeginInfo rpb{};
+                rpb.sType             = VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO;
+                rpb.renderPass        = pfRP;
+                rpb.framebuffer       = faceFB;
+                rpb.renderArea.extent = {mipSize, mipSize};
+                rpb.clearValueCount   = 1;
+                rpb.pClearValues      = &cv;
